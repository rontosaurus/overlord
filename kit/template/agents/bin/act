#!/usr/bin/env bash
# act — one activity line: what an agent DID (drift is for what went wrong). Every unattended non-read action
# writes one; the tick's morning brief summarises the last day of them.
# usage: act <initiative|-> "<what, one line>" [--undo "<how to undo>"] [--proof "<path or command>"]
# Appends a TSV row to agents/state/activity.tsv (ts, who, initiative, what, undo, proof).
set -euo pipefail
REPO="${AGENTS_REPO:-$(cd "$(dirname "$0")/../.." && pwd)}"
F="$REPO/agents/state/activity.tsv"
[ "${AGENT_EVAL:-0}" = 1 ] && { echo "act: eval run, not recorded"; exit 0; }   # test replays never write real activity
[ $# -ge 2 ] || { echo 'usage: act <initiative|-> "<what>" [--undo "..."] [--proof "..."]' >&2; exit 2; }
init="$1"; what="$2"; shift 2
undo="" proof=""
while [ $# -gt 0 ]; do case "$1" in
  --undo) undo=${2:?}; shift 2;; --proof) proof=${2:?}; shift 2;;
  *) echo "act: unknown arg $1" >&2; exit 2;; esac; done
who="${AGENT_ROLE:-interactive}"; [ -n "${AGENT_TYPE:-}" ] && who="$who/$AGENT_TYPE"
mkdir -p "$(dirname "$F")"
[ -f "$F" ] || printf 'ts\twho\tinitiative\twhat\tundo\tproof\n' > "$F"
clean() { printf '%s' "$1" | tr '\t\n\r' '   ' | head -c 400; }
printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -Is)" "$who" "$init" "$(clean "$what")" "$(clean "$undo")" "$(clean "$proof")" >> "$F"
echo "act: $(clean "$what")"
