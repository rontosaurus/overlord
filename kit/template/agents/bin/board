JS = """(function(){var e=document.getElementById('rendered');if(!e)return;var t=+e.dataset.epoch,m=(Date.now()/1000-t)/60;
if(m>10){e.parentNode.className+=' bad';e.textContent=e.textContent+' - STALE '+Math.round(m)+' min'}})();"""
COLS = [("running", "Running", "overseers with a live pid, then open initiatives"),
        ("waiting", "Waiting on you", "open asks and staged actions"),
        ("autonomous", "Autonomous", "what ran unattended, last %d h (activity.tsv)" % ACTIVITY_HOURS),
        ("closed", "Recently closed", ""),
        ("history", "History", "every report filed")]


def link_html(l):
    return '<a href="%s">%s</a>' % (html.escape(l["href"]), l["label"]) if l["href"] else '<span class="wh">%s withheld</span>' % l["label"]


def render_card(c):
    if c.get("kind") == "brief":
        return '<div class="card brief"><div class="t">%s</div><pre>%s</pre><div class="meta">%s</div></div>' % (
            html.escape(c["title"]), html.escape(c["excerpt"] or "(empty)"), " ".join(link_html(l) for l in c["links"]))
    if c.get("kind") == "act":
        meta = [html.escape(c["when"]), html.escape(c["who"])]
        if c["undo"]:
            meta.append("undo: " + html.escape(c["undo"]))
        if c["proof"]:
            meta.append("proof: <code>%s</code>" % html.escape(c["proof"]))
        return '<div class="card"><div class="t">%s</div><div class="s">%s</div><div class="meta">%s</div></div>' % (
            html.escape(c["initiative"]), html.escape(c["status"]), " · ".join(meta))
    cls = ["card"] + (["live"] if c.get("live") else []) + (["stale"] if c.get("stale") else []) + (["answered"] if c.get("answered") else [])
    short = shorten(c["status"], 170)
    meta = []
    if c.get("live"):
        meta.append('<span class="live">● live pid %d</span>' % c["live"]["pid"])
    if c.get("age") is not None:
        meta.append("%s %dd ago" % (c["age_label"], c["age"]))
    if c.get("touched") and c["col"] in ("open", "running", "waiting", "closed", "history"):
        td = c.get("touched_days")
        meta.append('<span class="%s">touched %s</span>' % ("warn" if c.get("stale") else "", c["touched"] if td is None else "%s (%dd)" % (c["touched"], td)))
    if c.get("answered"):
        meta.append("go recorded")
    if c.get("branch"):
        meta.append("<code>%s</code>" % html.escape(c["branch"]))
    meta += [link_html(l) for l in c["links"]]
    more = []
    for k, lab in (("goal", "goal"), ("why", "why"), ("staged_where", "staged"), ("spec", "file")):
        if c.get(k):
            more.append("<div><i>%s:</i> %s</div>" % (lab, html.escape(c[k])))
    if len(plain(c["status"])) > len(short):
        more.append("<div>%s</div>" % inline(c["status"]))
    full = "<details><summary>more</summary>%s</details>" % "".join(more) if more else ""
    return '<div class="%s"><div class="t">%s</div><div class="s">%s</div><div class="meta">%s</div>%s</div>' % (
        " ".join(cls), html.escape(c["title"]), html.escape(short), " ".join(meta), full)


def render_strategist(m):
    sg = m.get("strategist") or {}
    have = sg.get("have", {})
    nl, n = "", sg.get("next")
    if n:
        age = ""
        if n.get("age_days") is not None:
            ah = n.get("age_hours", 0)
            age = ' <small class="%s">(next.md %s ago)</small>' % ("warn" if n["age_days"] >= 3 else "", ("%dh" % ah) if ah < 48 else "%dd" % n["age_days"])
        nl = '<div class="nowline"><b>now</b> %s · <b>on deck</b> %s · <b>week</b> %s%s</div>' % (
            html.escape(n["now"] or "—"), html.escape(n["deck"] or "—"), html.escape(n["week"] or "unset"), age)
    panes = []
    if have.get("priorities.md"):
        pr = sg.get("priorities") or []
        body = "".join('<div class="row"><span class="sl %s">%s</span><b>%s</b><div class="m">%s</div><div class="m">next: %s · since %s</div></div>' % (
            html.escape(plain(r["slot"]).lower()), html.escape(plain(r["slot"]).lower()), inline(shorten(col(r, "what"), 140)),
            html.escape(shorten(col(r, "why"), 160)), html.escape(shorten(col(r, "next"), 160)), html.escape(col(r, "since"))) for r in pr)
        panes.append(("Priorities", "ranked (priorities.md)", body or '<div class="empty">nothing ranked</div>', len(pr)))
    if have.get("arc.md"):
        arc = (sg.get("arc") or []) + (sg.get("outside") or [])
        body = ""
        for r in arc:
            al = col(r, "alarms")
            pills = "".join('<span class="pl %s">%s</span>' % (a, a) for a in ("DEAD", "STALE", "ORPHAN") if a in al)
            body += '<div class="row"><b>%s</b> %s · %s%s<div class="m">initiatives: %s · last moved %s</div></div>' % (
                html.escape(col(r, "spec")), html.escape(shorten(col(r, "status"), 80)), html.escape(col(r, "owner")), pills,
                html.escape(col(r, "initiatives")), html.escape(col(r, "last moved")))
        if sg.get("moved"):
            body = '<div class="sub">moved since</div>' + "".join('<div class="row m">%s</div>' % html.escape(x) for x in sg["moved"]) + body
        panes.append(("Arc", "one line per workstream (arc.md)", body or '<div class="empty">nothing</div>', len(arc)))
    if have.get("threads.md"):
        th = sg.get("threads") or []
        body = "".join('<div class="row"><b>%s</b> <span class="pl">%s</span><div class="m">waiting on %s · since %s</div><div class="m">check: %s</div></div>' % (
            inline(shorten(col(r, "thread"), 120)), html.escape(plain(col(r, "tag"))), html.escape(shorten(col(r, "waiting on"), 100)),
            html.escape(col(r, "since")), html.escape(shorten(col(r, "how to check"), 140))) for r in th)
        panes.append(("Threads", "waiting on the world (threads.md)", body or '<div class="empty">nothing</div>', len(th)))
    return nl, panes


def render_html(m):
    ts = m["rendered"].replace("T", " ")
    strip = ['<span class="pill"><span id="rendered" data-epoch="%d">rendered <b>%s</b></span></span>' % (m["rendered_epoch"], ts),
             '<span class="pill">last wake <b>%s</b></span>' % html.escape(m["last_wake"] or "unknown"),
             '<span class="pill">open asks <b>%d</b></span>' % m["asks_open"]]
    t = m.get("tick")
    strip.append('<span class="pill">last tick <b>%s</b></span>' % (html.escape("%s · %s · %s" % (t["finished"][:16].replace("T", " ") or "?", t["mode"], t["subtype"])) if t else "no tick yet"))
    cg = m.get("ceiling")
    if cg:
        strip.append('<span class="pill">today attended <b>$%.2f</b></span>' % cg["attended_usd"])
        strip.append('<span class="pill%s">unattended <b>$%.2f of $%.2f</b></span>' % (" bad" if cg["spent"] else "", cg["usd_used"], cg["usd_ceiling"]))
    tc = m["triage"]["counts"]
    strip.append('<span class="pill">waiting on you <b>%d</b> · in flight <b>%d</b> · idle >=%dd <b>%d</b></span>' % (tc["waiting"], tc["inflight"], IDLE_DAYS, tc["idle"]))
    p = ['<h1>work board</h1><div class="strip">%s</div>' % "".join(strip)]
    for e in m["errors"]:
        p.append('<div class="banner">parse error - <b>%s</b>%s: %s</div>' % (html.escape(e["section"]), (", line %d" % e["line"]) if e["line"] else "", html.escape(e["msg"])))
    nl, panes = render_strategist(m)
    p.append(nl)
    p.append('<div class="cols">')
    for name, hint, body, n in panes:
        p.append('<section class="col"><h2>%s <span class="n">%d</span><small>%s</small></h2>%s</section>' % (name, n, html.escape(hint), body))
    for key, name, hint in COLS:
        if key == "running":
            cs = [c for c in m["cards"] if c["col"] in ("running", "open")]
            live = [c for c in cs if c["col"] == "running"]
            idle = [c for c in cs if c["col"] == "open"]
            body = "".join(render_card(c) for c in live) or '<div class="empty">no live overseer</div>'
            if idle:
                body += '<div class="sub">open, no live run</div>' + "".join(render_card(c) for c in idle)
            n = len(live)
        else:
            cs = [c for c in m["cards"] if c["col"] == key]
            n = len(cs)
            body = "".join(render_card(c) for c in cs[:HISTORY_LIMIT]) or '<div class="empty">nothing</div>'
            if n > HISTORY_LIMIT:
                body += '<div class="sub">+%d more in board.json</div>' % (n - HISTORY_LIMIT)
        p.append('<section class="col"><h2>%s <span class="n">%d</span><small>%s</small></h2>%s</section>' % (name, n, html.escape(hint), body))
    p.append("</div>")
    csp = "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; script-src 'sha256-%s'" % base64.b64encode(hashlib.sha256(JS.encode()).digest()).decode()
    return ('<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'
            '<meta http-equiv="Content-Security-Policy" content="%s"><meta http-equiv="refresh" content="60">'
            '<title>work board</title><style>%s</style></head><body>%s<script>%s</script></body></html>') % (csp, CSS, "".join(p), JS)


# ---------- output ----------
MARKER = ".board-out"


def write_atomic(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp.%d" % os.getpid()
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(data)
    os.replace(tmp, path)


def emit(out, page, model, files):
    os.makedirs(out, exist_ok=True)
    if [f for f in os.listdir(out) if f not in (".render.lock", MARKER)] and not os.path.exists(os.path.join(out, MARKER)):
        sys.exit("board: %s is not empty and has no %s marker - refusing to write or prune there" % (out, MARKER))
    written = {MARKER, ".render.lock"}
    write_atomic(os.path.join(out, MARKER), "board output - written and pruned by agents/bin/board\n")
    for rel, body in files.items():
        write_atomic(os.path.join(out, rel), body)
        written.add(rel.replace("/", os.sep))
    write_atomic(os.path.join(out, "board.json"), json.dumps(model, indent=1))
    write_atomic(os.path.join(out, "index.html"), page)  # last: the page never links a file not yet there
    written |= {"board.json", "index.html"}
    for root, dirs, fs_ in os.walk(out, topdown=False):
        for f in fs_:
            if os.path.relpath(os.path.join(root, f), out) not in written:
                os.unlink(os.path.join(root, f))
        for d in dirs:
            try:
                os.rmdir(os.path.join(root, d))
            except OSError:
                pass


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--out")
    ap.add_argument("--band", action="store_true")
    ap.add_argument("--repo", default=os.environ.get("AGENTS_REPO") or os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", ".."))
    ap.add_argument("--now", help="test clock, ISO local time")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()
    repo = os.path.realpath(a.repo)
    now = dt.datetime.fromisoformat(a.now) if a.now else dt.datetime.now()
    if a.band:
        print("\n".join(band(repo, now)))
        return 0
    out = os.path.abspath(a.out or os.path.join(repo, "agents/state/board"))
    if not a.out and not (os.path.realpath(out) + os.sep).startswith(repo + os.sep):
        print("board: refusing to render: %s resolves outside the repo (a symlink?). Pass --out DIR to choose a folder yourself." % out, file=sys.stderr)
        return 1
    os.makedirs(out, exist_ok=True)
    lock = open(os.path.join(out, ".render.lock"), "w")
    if fcntl:
        fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        model, files = build(repo, now)
        page = render_html(model)
        emit(out, page, model, files)
    except SystemExit:
        raise
    except Exception as e:
        print("board: render failed: %r" % e, file=sys.stderr)
        return 1
    if a.json:
        print(json.dumps(model, indent=1))
    for e in model["errors"]:
        print("board: parse error [%s] line %s: %s" % (e["section"], e["line"], e["msg"]), file=sys.stderr)
    print("board: wrote %s" % os.path.join(out, "index.html"), file=sys.stderr)
    return 2 if model["errors"] else 0


if __name__ == "__main__":
    sys.exit(main())
