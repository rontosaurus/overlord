#!/usr/bin/env python3
"""board — render the overlord's state as a local, read-only work board (page + JSON + a four-line band).

A PROJECTION of agents/state/overlord.md (plus, when present, next.md, priorities.md, threads.md, arc.md,
activity.tsv, costs.tsv, runs/), never a tracker: it reads, it never writes state. Local only: no server,
no network, no login. Open the page with a browser (file://), or read board.json.

  board                      render into <repo>/agents/state/board/ (index.html, board.json, files/)
  board --out DIR            render into DIR instead (created; refused if DIR is non-empty and not ours)
  board --out DIR --json     also print the model to stdout
  board --band               four plain-text lines (now / asks / ran / tick) for a status line or the mod
  options: --repo PATH (repo root; default $AGENTS_REPO, else two levels above this script), --now ISO (test clock)

Exit: 0 clean render · 2 rendered, but a section failed to parse (the page carries a banner naming it) ·
1 could not render at all. `--band` always exits 0. Python 3 standard library only.

Every optional file may be missing: the matching pane says "no <file> yet" and nothing fails.
Formats (all Markdown tables, first row = header, matched by column NAME so extra columns are fine):
  overlord.md    "## Open initiatives" (id, goal, brief, branch, status, opened) · "## Ask the owner ..." (#, action
                 staged, why, staged where, go, opened — an ask is open until its go cell has text) ·
                 "## Recently closed" (id, outcome, attestations verified, closed) · "## Last wake" (first line)
  next.md        line 1 "updated YYYY-MM-DD HH:MM"; then "now · ...", "on deck · ...", "week · ..." lines
  priorities.md  columns: # | slot | what | why | next (who) | since | source   (slot: tap reply at-pc evening decide)
  threads.md     columns: thread | waiting on | since | how to check | tag        (tag "owner" = waiting on you)
  arc.md         "## Specs" (and optional "## Outside the phases") table: spec | status | owner | initiatives |
                 last moved | alarms ; optional "## Moved since" bullets
  activity.tsv   ts <TAB> who <TAB> initiative <TAB> what <TAB> undo <TAB> proof     (the action log)
  costs.tsv      ts, id, model, turns, cost_usd, duration_s, subtype, origin          (origin "unattended" binds)
  ceiling.json   {"daily_usd": N, "daily_turns": N}
  runs/<id>.pid + runs/<id>.json (live overseer), runs/tick.json ({"finished","mode","result":{"subtype"}}; else the newest tick row of costs.tsv)
"""
import argparse, base64, datetime as dt, hashlib, html, json, os, re, stat, sys, unicodedata

try:
    import fcntl  # POSIX only; the render lock is skipped where it is missing
except ImportError:  # pragma: no cover
    fcntl = None

IDLE_DAYS = 3
ACTIVITY_HOURS = 24
ACTIVITY_LIMIT = 40
HISTORY_LIMIT = 60
WITHHELD = "[withheld - secret-shaped text]"
SAFE_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
STRAT_SLOTS = ("tap", "reply", "at-pc", "evening", "decide")
OWNER_NEXT = re.compile(r"\b(?:owner|you|your)\s+next\b|\bowner:", re.I)
ACT_COLS = ["ts", "who", "initiative", "what", "undo", "proof"]
OPEN_FLAGS = getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)

# Secret shapes: keyword=value, private-key header, common provider key prefixes, long mixed tokens, bearer headers.
SECRET_RE = re.compile(
    r"(?:api[_-]?key|secret|token|passw(?:or)?d|credential)s?\s*[:=]\s*[\"']?[A-Za-z0-9/+_.=-]{12,}"
    r"|-----BEGIN [A-Z ]*PRIVATE KEY-----|\bAKIA[0-9A-Z]{16}\b|\bgh[pousr]_[A-Za-z0-9]{20,}|\bsk-[A-Za-z0-9_-]{20,}"
    r"|\bBearer\s+[A-Za-z0-9._~+/=-]{16,}"
    r"|\b(?=[A-Za-z0-9_-]*[A-Z])(?=[A-Za-z0-9_-]*[a-z])(?=[A-Za-z0-9_-]*\d)[A-Za-z0-9_-]{40,}\b", re.I)


def secretish(text):
    return bool(SECRET_RE.search(text))


# ---------- small helpers ----------
def plain(s):
    return re.sub(r"[*`]", "", s or "")


def shorten(s, n):
    s = plain(s)
    return s if len(s) <= n else s[:n].rsplit(" ", 1)[0] + " ..."


def inline(s):
    s = html.escape(s, quote=False)
    s = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", s)
    return re.sub(r"`([^`]+)`", r"<code>\1</code>", s)


def parse_date(s):
    m = re.search(r"(\d{4}-\d{2}-\d{2})(?:[ T~]+(\d{1,2}):(\d{2}))?", s or "")
    if not m:
        return None
    try:
        d = dt.datetime.strptime(m.group(1), "%Y-%m-%d")
    except ValueError:
        return None
    return d.replace(hour=int(m.group(2)), minute=int(m.group(3))) if m.group(2) else d


def age_days(d, now):
    return None if d is None else max(0, (now.replace(tzinfo=None) - d).days)


def read_regular(path, cap=65536):
    """Text of a regular, non-symlink file (<= cap bytes), or None."""
    try:
        fd = os.open(path, os.O_RDONLY | OPEN_FLAGS)
        with os.fdopen(fd, encoding="utf-8", errors="replace") as fh:
            if not stat.S_ISREG(os.fstat(fh.fileno()).st_mode):
                return None
            return fh.read(cap)
    except OSError:
        return None


BIG = 64 << 20


def rtext(path, cap=BIG):
    """read_regular, but raising OSError when the file is missing / not a regular file / a symlink (callers already catch OSError)."""
    t = read_regular(path, cap)
    if t is None:
        raise OSError("not a readable regular file: %s" % path)
    return t


def jload(path):
    return json.loads(rtext(path, 1 << 20))


def clean_line(s):
    """No terminal escapes or invisible format characters from file-written text."""
    s = "".join(ch for ch in s if unicodedata.category(ch) != "Cf")
    return re.sub(r"[\x00-\x1f\x7f-\x9f]", " ", s)


# ---------- markdown tables ----------
def split_row(l):
    s = l.strip().strip("|").replace("\\|", "\x00")
    return [c.strip().replace("\x00", "|") for c in s.split("|")]


def md_sections(text):
    out, cur = {"": (0, [])}, ""
    for i, l in enumerate(text.split("\n"), 1):
        if l.startswith("## "):
            cur = l[3:].strip()
            out[cur] = (i, [])
        else:
            out[cur][1].append((i, l))
    return out


def sec(secs, prefix):
    k = next((k for k in secs if k and k.lower().startswith(prefix.lower())), None)
    return secs[k] if k else None


def table(name, lines, head_line, errors, must):
    """First table in `lines` -> list of dicts keyed by lower-cased header. `must` = column names that have to exist
    (a prefix match is enough: 'go' finds 'go (who / when)'). Blank placeholder rows are dropped."""
    rows = [(n, l) for n, l in lines if l.lstrip().startswith("|")]
    if len(rows) < 2:
        errors.append({"section": name, "line": head_line, "msg": "no table found"})
        return []
    hn, hl = rows[0]
    header = [c.lower() for c in split_row(hl)]
    miss = [m for m in must if not any(h == m or h.startswith(m) for h in header)]
    if miss:
        errors.append({"section": name, "line": hn, "msg": "table has no '%s' column" % "', '".join(miss)})
        return []
    out = []
    for n, l in rows[2:]:
        c = split_row(l)
        if len(c) != len(header):
            errors.append({"section": name, "line": n, "msg": "row has %d cells, expected %d (unescaped '|' in a cell?)" % (len(c), len(header))})
            continue
        if not any(x.strip(" -") for x in c):
            continue
        out.append(dict(zip(header, c), _line=n))
    return out


def col(row, *names):
    """Cell by column name; a prefix of the header counts ('go' -> 'go (who / when)')."""
    for n in names:
        for k, v in row.items():
            if k == n or (not k.startswith("_") and k.startswith(n)):
                return v
    return ""


# ---------- state ----------
def parse_overlord(text, errors):
    secs = md_sections(text)
    out = {"last_wake": "", "inits": [], "asks": [], "closed": []}
    for key, prefix, must in (("inits", "Open initiatives", ["id"]), ("asks", "Ask", ["#"]), ("closed", "Recently closed", ["id"])):
        s = sec(secs, prefix)
        if s is None:
            errors.append({"section": prefix, "line": 0, "msg": "section heading missing"})
            continue
        out[key] = table(prefix, s[1], s[0], errors, must)
    s = sec(secs, "Last wake")
    if s:
        out["last_wake"] = next((plain(l).strip() for _, l in s[1] if l.strip()), "")
    else:
        errors.append({"section": "Last wake", "line": 0, "msg": "section heading missing"})
    return out


def pid_alive(runs, id_):
    """A live overseer = a pid file whose pid is running and whose run json has no 'finished'."""
    try:
        with open(os.path.join(runs, id_ + ".pid")) as fh:
            pid = int(fh.read().strip())
    except (OSError, ValueError):
        return None
    meta = {}
    try:
        meta = jload(os.path.join(runs, id_ + ".json"))
    except (OSError, ValueError):
        pass
    if meta.get("finished"):
        return None
    try:
        if os.path.isdir("/proc"):
            alive = os.path.isdir("/proc/%d" % pid)
        else:
            os.kill(pid, 0)
            alive = True
    except OSError:
        alive = False
    return {"pid": pid, "started": meta.get("started")} if alive else None


def read_tick(st):
    """runs/tick.json if a tick wrote one, else the newest costs.tsv row whose id is tick*; None when neither exists."""
    try:
        j = jload(os.path.join(st, "runs", "tick.json"))
        return {"finished": str(j.get("finished") or ""), "mode": str(j.get("mode") or "?"),
                "subtype": str((j.get("result") or {}).get("subtype") or "?")}
    except (OSError, ValueError, AttributeError):
        pass
    mode = "?"
    try:
        mode = str(jload(os.path.join(st, "ceiling.json")).get("tick_mode") or "?")
    except (OSError, ValueError, AttributeError):
        pass
    last = None
    try:
        for i, l in enumerate(rtext(os.path.join(st, "costs.tsv")).split("\n")):
            c = l.rstrip("\n").split("\t")
            if i and len(c) >= 7 and c[1].startswith("tick"):
                last = c
    except OSError:
        pass
    return {"finished": last[0], "mode": mode, "subtype": last[6]} if last else None


def limits(st):
    """WIP limits from ceiling.json (wip_initiatives / ask_backpressure); the mod reads them from board.json."""
    try:
        cfg = jload(os.path.join(st, "ceiling.json"))
        return {"wip_initiatives": int(cfg.get("wip_initiatives") or 0) or None, "ask_backpressure": int(cfg.get("ask_backpressure") or 0) or None}
    except (OSError, ValueError, TypeError, AttributeError):
        return {"wip_initiatives": None, "ask_backpressure": None}


def read_activity(path, errors):
    rows = []
    try:
        lines = rtext(path).split("\n")
    except OSError:
        return rows
    for n, l in enumerate(lines, 1):
        if (n == 1 and l.startswith("ts\t")) or not l.strip():
            continue
        c = l.split("\t")
        try:
            if len(c) != len(ACT_COLS):
                raise ValueError("fields")
            ts = dt.datetime.fromisoformat(c[0]).replace(tzinfo=None)
        except ValueError:
            errors.append({"section": "activity.tsv", "line": n, "msg": "malformed row skipped"})
            continue
        rows.append(dict(zip(ACT_COLS, c), ts=ts, _line=n))
    return rows


def ceiling(st, now):
    """Today's unattended spend against ceiling.json, from costs.tsv. None when either file is absent."""
    try:
        cfg = jload(os.path.join(st, "ceiling.json"))
        usd_c, turns_c = float(cfg["daily_usd"]), float(cfg.get("daily_turns") or 0)
    except (OSError, ValueError, KeyError, TypeError):
        return None
    day, uu, ut, au = now.strftime("%Y-%m-%d"), 0.0, 0.0, 0.0
    try:
        for i, l in enumerate(rtext(os.path.join(st, "costs.tsv")).split("\n")):
            c = l.rstrip("\n").split("\t")
            if i == 0 or len(c) < 5 or c[0][:10] != day:
                continue
            try:
                cost, turns = float(c[4] or 0), float(c[3] or 0)
            except ValueError:
                continue
            if len(c) >= 8 and c[7] == "unattended":
                uu, ut = uu + cost, ut + turns
            else:
                au += cost
    except OSError:
        pass
    return {"date": day, "usd_used": round(uu, 4), "usd_ceiling": usd_c, "turns_used": ut, "turns_ceiling": turns_c,
            "spent": uu >= usd_c or (turns_c > 0 and ut >= turns_c), "attended_usd": round(au, 4)}


def file_times(st, id_):
    """Newest mtime of anything on disk that names this id: its brief, its reports, its run files."""
    ts = []
    for d, match in (("briefs", lambda f: f.startswith(id_ + ".")), ("reports", lambda f: f.startswith(id_ + "-")),
                     ("runs", lambda f: f.startswith(id_))):
        try:
            for f in os.listdir(os.path.join(st, d)):
                if match(f):
                    ts.append(os.stat(os.path.join(st, d, f)).st_mtime)
        except OSError:
            pass
    return dt.datetime.fromtimestamp(max(ts)) if ts else None


# ---------- strategist files ----------
def read_strategist(st, now, errors, publish, card):
    out = {"next": None, "priorities": [], "threads": [], "arc": [], "outside": [], "moved": [], "have": {}}
    t = read_regular(os.path.join(st, "next.md"))
    out["have"]["next.md"] = t is not None
    if t is not None:
        n = {"updated": None, "age_days": None, "age_hours": 0, "now": "", "deck": "", "week": ""}
        for l in t.split("\n"):
            m = re.match(r"^\W*(now|on deck|week)\s*[·:\-—]\s*(.*)$", l.strip(), re.I)
            if m:
                n[{"now": "now", "on deck": "deck", "week": "week"}[m.group(1).lower()]] = clean_line(m.group(2).strip()[:160])
        d = parse_date(t.split("\n", 1)[0])
        if d:
            n["updated"], n["age_days"] = d.strftime("%Y-%m-%d %H:%M"), age_days(d, now)
            n["age_hours"] = max(0, int((now.replace(tzinfo=None) - d).total_seconds() // 3600))
        if not (n["now"] or n["deck"] or n["week"]):
            errors.append({"section": "next.md", "line": 0, "msg": "no 'now · / on deck · / week ·' lines found"})
        else:
            out["next"] = n
    for fname, key, must in (("priorities.md", "priorities", ["slot", "what"]), ("threads.md", "threads", ["thread"])):
        t = read_regular(os.path.join(st, fname))
        out["have"][fname] = t is not None
        if t is None:
            continue
        rows = table(fname, list(enumerate(t.split("\n"), 1)), 1, errors, must)
        if key == "priorities":
            keep = []
            for r in rows:
                if plain(r.get("slot", "")).strip().lower() in STRAT_SLOTS:
                    keep.append(r)
                else:
                    errors.append({"section": fname, "line": r["_line"], "msg": "slot must be one of %s" % ", ".join(STRAT_SLOTS)})
            rows = keep
        out[key] = rows
    t = read_regular(os.path.join(st, "arc.md"))
    out["have"]["arc.md"] = t is not None
    if t is not None:
        secs = md_sections(t)
        s = sec(secs, "Specs")
        if s:
            out["arc"] = table("arc.md § Specs", s[1], s[0], errors, ["spec"])
        s = sec(secs, "Outside")
        if s:
            out["outside"] = table("arc.md § Outside", s[1], s[0], errors, ["spec"])
        s = sec(secs, "Moved since")
        out["moved"] = [clean_line(l[2:].strip()) for _, l in (s[1] if s else []) if l.startswith("- ")][:10]
    return out


def scrub(obj):
    if isinstance(obj, str):
        return WITHHELD if secretish(obj) else clean_line(obj)
    if isinstance(obj, list):
        return [scrub(x) for x in obj]
    if isinstance(obj, dict):
        return {k: (v if k.startswith("_") else scrub(v)) for k, v in obj.items()}
    return obj


# ---------- model ----------
def build(repo, now):
    errors = []
    st = os.path.join(repo, "agents/state")
    text = read_regular(os.path.join(st, "overlord.md"), cap=1 << 20)
    if text is None:
        errors.append({"section": "overlord.md", "line": 0, "msg": "cannot read agents/state/overlord.md"})
    parsed = parse_overlord(text, errors) if text else {"last_wake": "", "inits": [], "asks": [], "closed": []}
    runs = os.path.join(st, "runs")
    files = {}  # relpath under the out dir -> text

    def publish(kind, name, c, label, srcdir=None):
        """Copy a brief/report next to the page as plain text, secret-scanned. Returns a link dict or None."""
        if not SAFE_NAME.match(name):
            return None
        body = read_regular(os.path.join(st, srcdir or kind, name), cap=1 << 20)
        if body is None:
            return None
        if secretish(body):
            c["withheld"] = True
            return {"label": label, "href": None}
        if srcdir:
            c["_body"] = body
        rel = "files/%s/%s" % (kind, name)
        files[rel] = body
        return {"label": label, "href": rel}

    def card(col_, id_, title, status, **kw):
        c = {"col": col_, "id": id_, "title": title, "status": status, "links": [], "touched": None, "touched_days": None, "age": None, "stale": False}
        c.update(kw)
        return c

    acts_all = read_activity(os.path.join(st, "activity.tsv"), errors)
    act_by_id = {}
    for r in acts_all:
        if r["initiative"] not in act_by_id or r["ts"] > act_by_id[r["initiative"]]:
            act_by_id[r["initiative"]] = r["ts"]
    nn = now.replace(tzinfo=None)
    cards, tri_cards = [], []

    for r in parsed["inits"]:
        id_ = plain(col(r, "id")).strip()
        status = col(r, "status") or col(r, "goal")
        opened = parse_date(col(r, "opened", "dispatched"))
        live = pid_alive(runs, id_)
        c = card("running" if live else "open", id_, id_, status, goal=shorten(col(r, "goal"), 120), branch=shorten(col(r, "branch"), 60),
                 live=live, age=age_days(opened, now), age_label="opened", line=r["_line"])
        for sub, nm in (("briefs", id_ + ".md"),):
            if os.path.exists(os.path.join(st, sub, nm)):
                l = publish(sub, nm, c, "brief")
                if l:
                    c["links"].append(l)
        try:
            reps = sorted(f for f in os.listdir(os.path.join(st, "reports")) if f.startswith(id_ + "-") and f.endswith(".md"))[-2:]
        except OSError:
            reps = []
        for rp in reps:
            l = publish("reports", rp, c, "report")
            if l:
                c["links"].append(l)
        newest = max([x for x in (file_times(st, id_), act_by_id.get(id_), opened) if x], default=None)
        c["touched"] = newest.strftime("%Y-%m-%d") if newest else None
        c["touched_days"] = age_days(newest, now)
        c["stale"] = bool(c["touched_days"] is not None and c["touched_days"] >= IDLE_DAYS)
        cards.append(c)
        tri_cards.append({"id": id_, "kind": "init", "lane": "waiting" if OWNER_NEXT.search(plain(status)) else "inflight",
                          "text": shorten(status, 220), "idle": c["touched_days"], "live": bool(live)})
    for r in parsed["asks"]:
        num = plain(col(r, "#")).strip()
        go = plain(col(r, "go")).strip()
        answered = bool(go) and not re.match(r"^(—|-|–|none|pending|open|n/?a|\?)$", go, re.I)
        d = parse_date(col(r, "opened", "asked"))
        what = col(r, "action staged") or col(r, "what")
        c = card("waiting", "#" + num, "#%s" % num, what, answered=answered, age=age_days(d, now), age_label="asked", line=r["_line"],
                 staged_where=shorten(col(r, "staged where"), 160), why=shorten(col(r, "why"), 200),
                 touched=d.strftime("%Y-%m-%d") if d else None, touched_days=age_days(d, now))
        c["stale"] = bool(c["touched_days"] is not None and c["touched_days"] >= IDLE_DAYS and not answered)
        cards.append(c)
        if not answered:
            tri_cards.append({"id": "#" + num, "kind": "ask", "lane": "waiting", "text": shorten(what, 220), "idle": c["touched_days"], "live": False})
    for r in parsed["closed"]:
        id_ = plain(col(r, "id")).strip()
        d = parse_date(col(r, "closed"))
        c = card("closed", id_, id_, col(r, "outcome"), age=age_days(d, now), age_label="closed", line=r["_line"],
                 touched=d.strftime("%Y-%m-%d") if d else None, touched_days=age_days(d, now))
        cards.append(c)
    # History: every report ever filed (<id>-YYYYMMDD-HHMM.md)
    try:
        rep_names = sorted(os.listdir(os.path.join(st, "reports")))
    except OSError:
        rep_names = []
    for fn in rep_names:
        m = re.match(r"^(.+)-(\d{8}-\d{4})\.md$", fn)
        if not m:
            continue
        try:
            d = dt.datetime.strptime(m.group(2), "%Y%m%d-%H%M")
        except ValueError:
            continue
        hc = card("history", m.group(1), m.group(1), "report filed", spec="reports/%s" % fn, touched=d.strftime("%Y-%m-%d"), touched_days=age_days(d, now))
        l = publish("reports", fn, hc, "report")
        if l:
            hc["links"].append(l)
        cards.append(hc)
    # Autonomous: what ran unattended in the last ACTIVITY_HOURS (activity.tsv), newest first, + the newest morning brief
    try:
        bnames = sorted(f for f in os.listdir(os.path.join(st, "brief")) if f.endswith("-morning.md") and SAFE_NAME.match(f))
    except OSError:
        bnames = []
    if bnames:
        c = card("autonomous", "brief", "morning brief - " + bnames[-1][:-len("-morning.md")], "", kind="brief", excerpt="")
        l = publish("briefs", bnames[-1], c, "full brief", srcdir="brief")
        body = c.pop("_body", None)
        if l:
            c["links"].append(l)
            c["excerpt"] = "\n".join(body.split("\n")[:14]) if body is not None else WITHHELD
            cards.append(c)
    recent = [r for r in acts_all if nn - dt.timedelta(hours=ACTIVITY_HOURS) <= r["ts"] <= nn + dt.timedelta(minutes=5)]
    recent.sort(key=lambda r: r["ts"], reverse=True)
    for r in recent[:ACTIVITY_LIMIT]:
        cards.append(card("autonomous", "act:%d" % r["_line"], r["initiative"], r["what"], kind="act", who=r["who"], initiative=r["initiative"],
                          undo=r["undo"], proof=r["proof"], when=r["ts"].strftime("%m-%d %H:%M")))
    cards.sort(key=lambda c: -1 if c["col"] != "history" else (c["touched_days"] if c.get("touched_days") is not None else 10 ** 9))
    for c in cards:
        for k in ("title", "status", "staged_where", "why", "goal", "who", "initiative", "undo", "proof", "excerpt"):
            if c.get(k) and secretish(c[k]):
                c[k] = WITHHELD
    strat = read_strategist(st, now, errors, publish, card)
    strat = scrub(strat)
    waiting_n = sum(1 for t in tri_cards if t["lane"] == "waiting")
    tri = {"cards": tri_cards, "idle_days": IDLE_DAYS,
           "counts": {"waiting": waiting_n, "inflight": sum(1 for t in tri_cards if t["lane"] == "inflight"),
                      "idle": sum(1 for t in tri_cards if t["idle"] is not None and t["idle"] >= IDLE_DAYS)}}
    return {"rendered": now.strftime("%Y-%m-%dT%H:%M:%S"), "rendered_epoch": int(now.timestamp()),
            "last_wake": shorten(clean_line(parsed["last_wake"]), 140), "asks_open": sum(1 for c in cards if c["col"] == "waiting" and not c.get("answered")),
            "tick": read_tick(st), "ceiling": ceiling(st, now), "limits": limits(st),
            "errors": errors, "cards": scrub(cards), "strategist": strat, "triage": scrub(tri)}, files


def band(repo, now):
    """Four plain-text lines: now · asks · ran · tick. Never raises."""
    try:
        model, _ = build(repo, now)
        n = (model["strategist"].get("next") or {}).get("now") or "—"
        c = model["triage"]["counts"]
        asks = "%d waiting on you · %d in flight · %d idle >=%dd" % (c["waiting"], c["inflight"], c["idle"], IDLE_DAYS)
        ran = str(sum(1 for c_ in model["cards"] if c_["col"] == "autonomous" and c_.get("kind") == "act"))
        t = model["tick"]
        tick = (t["finished"][5:16].replace("T", " ") or "?") if t else "none"
        out = ["now · " + n, "asks · " + asks, "ran · " + ran, "tick · " + tick]
    except Exception:
        out = ["now · —", "asks · ?", "ran · ?", "tick · none"]
    return [WITHHELD if secretish(clean_line(l)) else clean_line(l) for l in out]


