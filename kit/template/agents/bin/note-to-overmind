#!/usr/bin/env bash
# note-to-overmind "<message>"  — append to the overlord→overmind channel (append-only)
set -u
f="${AGENTS_REPO:?set AGENTS_REPO}/agents/state/notes-to-overmind.md"
[ $# -ge 1 ] || { echo "usage: note-to-overmind <message>" >&2; exit 1; }
printf -- '- %s (%s%s) — %s\n' "$(date +%F)" "${AGENT_ROLE:-interactive}" "${AGENT_INITIATIVE:+/$AGENT_INITIATIVE}" "$*" >> "$f" && tail -1 "$f"
