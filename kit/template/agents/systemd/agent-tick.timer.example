# Copy next to agent-tick.service, then: systemctl enable --now agent-tick.timer
# The tick starts in propose mode (ceiling.json "tick_mode"): it only writes the morning brief until you flip it.
[Unit]
Description=Governor tick - daily, before your day starts

[Timer]
# Local time of the box. Pick an hour before you are awake.
OnCalendar=*-*-* 06:00:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
